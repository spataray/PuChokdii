# ===================================
# MULTI-USER PLATFORM CONFIGURATION
# ===================================

# Backend Server Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://yourusername.github.io/StockAlerts

# JWT Secret for user authentication (CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OAuth2 Email Configuration (Gmail)
# Get these credentials from Google Cloud Console
# Tutorial: https://developers.google.com/gmail/api/quickstart/nodejs
EMAIL_USER=youremail@gmail.com
OAUTH2_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH2_CLIENT_SECRET=GOCSPX-your-client-secret
OAUTH2_REFRESH_TOKEN=1//your-refresh-token-here

# Alpha Vantage API Key (for stock data)
# Get free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Chart URL (your deployed website or GitHub Pages URL)
CHART_BASE_URL=https://yourusername.github.io/StockAlerts

# ===================================
# LEGACY SINGLE-USER CONFIGURATION
# (Only needed if running old monitor script)
# ===================================

# Your phone number (where alerts will be sent via email-to-SMS)
ALERT_PHONE_NUMBER=1234567890

# Optional: Manually specify carrier (recommended for accuracy)
# Supported: verizon, att, tmobile, sprint, boost, cricket, metropcs, virgin, uscellular, straighttalk
CARRIER_OVERRIDE=verizon